{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherShell Widget Data Bindings Schema",
  "type": "object",
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "fallback_text"],
        "properties": {
          "source": { "type": "string" },
          "unit": { "type": "string" },
          "fallback_text": { "type": "string" },
          "max_age_ms": { "type": "integer", "minimum": 100 }
        }
      }
    }
  }
}
