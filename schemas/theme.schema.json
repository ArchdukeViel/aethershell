{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherShell Semantic Theme Schema",
  "type": "object",
  "required": ["schema_version", "id", "label", "colors", "typography", "shape"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string" },
    "label": { "type": "string" },
    "color_space": { "type": "string", "enum": ["srgb"] },
    "colors": {
      "type": "object",
      "required": ["surface", "text", "accent", "status"],
      "properties": {
        "surface": {
          "type": "object",
          "required": ["bg", "raised", "overlay", "border"]
        },
        "text": {
          "type": "object",
          "required": ["primary", "secondary", "disabled"]
        },
        "accent": {
          "type": "object",
          "required": ["primary", "secondary"]
        },
        "status": {
          "type": "object",
          "required": ["success", "warning", "danger"]
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["family", "mono_family", "scale"]
    },
    "shape": {
      "type": "object",
      "required": ["corner_radius_dip", "border_width_dip"]
    }
  }
}
