{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherShell Master Configuration Schema",
  "type": "object",
  "required": ["schema_version", "profile", "general", "taskbar", "desktop"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": { "type": "string" },
    "general": {
      "type": "object",
      "required": ["start_with_windows", "language", "safe_mode"],
      "properties": {
        "start_with_windows": { "type": "boolean" },
        "language": { "type": "string" },
        "safe_mode": { "type": "boolean" },
        "show_tray_icon": { "type": "boolean" }
      }
    },
    "taskbar": {
      "type": "object",
      "required": ["enabled", "engine", "on_unsupported", "conflict_policy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "type": "string", "enum": ["native_noop", "external_appearance", "explorer_xaml_experimental"] },
        "on_unsupported": { "type": "string", "enum": ["native_noop", "solid_fallback"] },
        "conflict_policy": { "type": "string", "enum": ["yield_and_notify", "disabled"] }
      }
    },
    "desktop": {
      "type": "object",
      "required": ["placement", "interaction_mode"],
      "properties": {
        "placement": { "type": "string", "enum": ["between_wallpaper_and_icons"] },
        "interaction_mode": { "type": "string", "enum": ["temporary_only", "locked_passive"] }
      }
    }
  }
}
