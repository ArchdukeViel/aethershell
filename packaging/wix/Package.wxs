<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AetherShell"
           Manufacturer="ArchdukeViel"
           Version="1.0.0.0"
           UpgradeCode="d78b87c1-7c92-4f36-b631-0cf24e6c3821"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of AetherShell is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="AetherShell">
        <Component Id="MainExecutable" Guid="b37a1f50-59a8-4bb6-88fe-1cb239dfa151">
          <File Id="AetherShellExe" Source="aethershell.exe" KeyPath="yes" />
        </Component>
        <Component Id="SettingsExecutable" Guid="c48b2e61-6ab9-4cc7-99ff-2dc340efb262">
          <File Id="SettingsExe" Source="aethershell-settings.exe" KeyPath="yes" />
        </Component>
        <Component Id="ScriptHostExecutable" Guid="d59c3f72-7bc0-4dd8-a000-3ed451f0c373">
          <File Id="ScriptHostExe" Source="aethershell-script-host.exe" KeyPath="yes" />
        </Component>
        <Component Id="SettingsRuntimeFiles" Guid="e71e5192-8cd2-4ee9-b222-5fe66201e595">
          <File Id="WinUiXamlDll" Source="Microsoft.ui.xaml.dll" KeyPath="yes" />
          <File Id="WinUiBootstrapDll" Source="Microsoft.WindowsAppRuntime.Bootstrap.dll" />
          <File Id="WinUiRuntimeDll" Source="Microsoft.WindowsAppRuntime.dll" />
          <File Id="WinUiControlsDll" Source="Microsoft.UI.Xaml.Controls.dll" />
          <File Id="WinUiControlsPri" Source="Microsoft.UI.Xaml.Controls.pri" />
          <File Id="WinUiAppXbf" Source="App.xbf" />
          <File Id="WinUiMainWindowXbf" Source="MainWindow.xbf" />
          <File Id="WinUiDWriteCoreDll" Source="DWriteCore.dll" />
          <File Id="WinUiDcompiDll" Source="dcompi.dll" />
          <File Id="WinUiDwmcoreiDll" Source="dwmcorei.dll" />
          <File Id="WinUiDwmSceneIDll" Source="DwmSceneI.dll" />
          <File Id="WinUiMrmDll" Source="MRM.dll" />
          <File Id="WinUiCoreMessagingXpDll" Source="CoreMessagingXP.dll" />
          <File Id="WinUiDirectManipulationDll" Source="Microsoft.DirectManipulation.dll" />
          <File Id="WinUiGraphicsDisplayDll" Source="Microsoft.Graphics.Display.dll" />
          <File Id="WinUiInputStateManagerDll" Source="Microsoft.InputStateManager.dll" />
          <File Id="WinUiInternalFrameworkUdkDll" Source="Microsoft.Internal.FrameworkUdk.dll" />
          <File Id="WinUiCompositionOSSupportDll" Source="Microsoft.UI.Composition.OSSupport.dll" />
          <File Id="WinUiDll" Source="Microsoft.UI.dll" />
          <File Id="WinUiInputDll" Source="Microsoft.UI.Input.dll" />
          <File Id="WinUiWindowingCoreDll" Source="Microsoft.UI.Windowing.Core.dll" />
          <File Id="WinUiWindowingDll" Source="Microsoft.UI.Windowing.dll" />
          <File Id="WinUiXamlInternalDll" Source="Microsoft.UI.Xaml.Internal.dll" />
          <File Id="WinUiXamlPhoneDll" Source="Microsoft.UI.Xaml.Phone.dll" />
          <File Id="WinUiXamlResources19h1Dll" Source="Microsoft.ui.xaml.resources.19h1.dll" />
          <File Id="WinUiXamlResourcesCommonDll" Source="Microsoft.ui.xaml.resources.common.dll" />
          <File Id="WinUiWebview2CoreDll" Source="Microsoft.Web.WebView2.Core.dll" />
          <File Id="WinUiAppModelResourcesDll" Source="Microsoft.Windows.ApplicationModel.Resources.dll" />
          <File Id="WinUiWidgetsDll" Source="Microsoft.Windows.Widgets.dll" />
          <File Id="WinUiInsightsResourceDll" Source="Microsoft.WindowsAppRuntime.Insights.Resource.dll" />
          <File Id="WinUiPushNotificationsDll" Source="PushNotificationsLongRunningTask.ProxyStub.dll" />
          <File Id="WinUiDeploymentDesktopEventLogDll" Source="WindowsAppSdk.AppxDeploymentExtensions.Desktop-EventLog-Instrumentation.dll" />
          <File Id="WinUiDeploymentDesktopDll" Source="WindowsAppSdk.AppxDeploymentExtensions.Desktop.dll" />
          <File Id="WinUiEditDll" Source="WinUIEdit.dll" />
          <File Id="WinUiWuceffectsiDll" Source="wuceffectsi.dll" />
          <File Id="WinUiMarshalDll" Source="marshal.dll" />
        </Component>

        <Directory Id="AssetsFolder" Name="assets">
          <Directory Id="ProfilesFolder" Name="profiles">
            <Component Id="ProfileFiles" Guid="f1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c">
              <File Id="SignatureMinimalProfile" Source="assets\profiles\signature_minimal.toml" KeyPath="yes" />
            </Component>
          </Directory>

          <Directory Id="ThemesFolder" Name="themes">
            <Component Id="ThemeFiles" Guid="a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d">
              <File Id="ArcticTheme" Source="assets\themes\arctic.toml" KeyPath="yes" />
              <File Id="AuroraTheme" Source="assets\themes\aurora.toml" />
              <File Id="MonochromeTheme" Source="assets\themes\monochrome.toml" />
              <File Id="NeonGridTheme" Source="assets\themes\neon_grid.toml" />
              <File Id="ObsidianTheme" Source="assets\themes\obsidian.toml" />
              <File Id="SolarTheme" Source="assets\themes\solar.toml" />
            </Component>
          </Directory>

          <Directory Id="SkinsFolder" Name="skins">
            <Directory Id="SkinAmbientSoft" Name="ambient_soft">
              <Component Id="SkinAmbientSoftFiles" Guid="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e">
                <File Id="AmbientSoftBindings" Source="assets\skins\ambient_soft\bindings.toml" KeyPath="yes" />
                <File Id="AmbientSoftLayout" Source="assets\skins\ambient_soft\layout.toml" />
                <File Id="AmbientSoftManifest" Source="assets\skins\ambient_soft\manifest.toml" />
              </Component>
            </Directory>
            <Directory Id="SkinCyberHud" Name="cyber_hud">
              <Component Id="SkinCyberHudFiles" Guid="c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f">
                <File Id="CyberHudBindings" Source="assets\skins\cyber_hud\bindings.toml" KeyPath="yes" />
                <File Id="CyberHudLayout" Source="assets\skins\cyber_hud\layout.toml" />
                <File Id="CyberHudManifest" Source="assets\skins\cyber_hud\manifest.toml" />
              </Component>
            </Directory>
            <Directory Id="SkinGlassBento" Name="glass_bento">
              <Component Id="SkinGlassBentoFiles" Guid="d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a">
                <File Id="GlassBentoBindings" Source="assets\skins\glass_bento\bindings.toml" KeyPath="yes" />
                <File Id="GlassBentoLayout" Source="assets\skins\glass_bento\layout.toml" />
                <File Id="GlassBentoManifest" Source="assets\skins\glass_bento\manifest.toml" />
              </Component>
            </Directory>
            <Directory Id="SkinMinimalType" Name="minimal_type">
              <Component Id="SkinMinimalTypeFiles" Guid="e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b">
                <File Id="MinimalTypeBindings" Source="assets\skins\minimal_type\bindings.toml" KeyPath="yes" />
                <File Id="MinimalTypeLayout" Source="assets\skins\minimal_type\layout.toml" />
                <File Id="MinimalTypeManifest" Source="assets\skins\minimal_type\manifest.toml" />
              </Component>
            </Directory>
            <Directory Id="SkinSpectrumDynamic" Name="spectrum_dynamic">
              <Component Id="SkinSpectrumDynamicFiles" Guid="f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c">
                <File Id="SpectrumDynamicBindings" Source="assets\skins\spectrum_dynamic\bindings.toml" KeyPath="yes" />
                <File Id="SpectrumDynamicLayout" Source="assets\skins\spectrum_dynamic\layout.toml" />
                <File Id="SpectrumDynamicManifest" Source="assets\skins\spectrum_dynamic\manifest.toml" />
              </Component>
            </Directory>
            <Directory Id="SkinTerminalMono" Name="terminal_mono">
              <Component Id="SkinTerminalMonoFiles" Guid="a7b8c9d0-e1f2-4a3b-4c5d-6e7f8a9b0c1d">
                <File Id="TerminalMonoBindings" Source="assets\skins\terminal_mono\bindings.toml" KeyPath="yes" />
                <File Id="TerminalMonoLayout" Source="assets\skins\terminal_mono\layout.toml" />
                <File Id="TerminalMonoManifest" Source="assets\skins\terminal_mono\manifest.toml" />
              </Component>
            </Directory>
          </Directory>
        </Directory>

        <Directory Id="SchemasFolder" Name="schemas">
          <Component Id="SchemaFiles" Guid="b8c9d0e1-f2a3-4b4c-5d6e-7f8a9b0c1d2e">
            <File Id="ConfigSchema" Source="schemas\config.schema.json" KeyPath="yes" />
            <File Id="ProfileSchema" Source="schemas\profile.schema.json" />
            <File Id="SkinManifestSchema" Source="schemas\skin-manifest.schema.json" />
            <File Id="ThemeSchema" Source="schemas\theme.schema.json" />
            <File Id="WidgetBindingsSchema" Source="schemas\widget-bindings.schema.json" />
            <File Id="WidgetLayoutSchema" Source="schemas\widget-layout.schema.json" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AetherShell">
        <Component Id="ApplicationShortcut" Guid="e60d4083-8cd1-4ee9-b111-4fe56201d484">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="AetherShell"
                    Description="Offline-First Windows Desktop Customization"
                    Target="[#AetherShellExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="SettingsStartMenuShortcut"
                    Name="AetherShell Settings"
                    Description="AetherShell Settings and Preferences"
                    Target="[#SettingsExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\ArchdukeViel\AetherShell" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AetherShell" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="SettingsExecutable" />
      <ComponentRef Id="ScriptHostExecutable" />
      <ComponentRef Id="SettingsRuntimeFiles" />
      <ComponentRef Id="ProfileFiles" />
      <ComponentRef Id="ThemeFiles" />
      <ComponentRef Id="SkinAmbientSoftFiles" />
      <ComponentRef Id="SkinCyberHudFiles" />
      <ComponentRef Id="SkinGlassBentoFiles" />
      <ComponentRef Id="SkinMinimalTypeFiles" />
      <ComponentRef Id="SkinSpectrumDynamicFiles" />
      <ComponentRef Id="SkinTerminalMonoFiles" />
      <ComponentRef Id="SchemaFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
