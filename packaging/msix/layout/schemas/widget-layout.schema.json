{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AetherShell Declarative Widget Layout Schema",
  "type": "object",
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "node_limit": { "type": "integer", "minimum": 1, "maximum": 128 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["container", "text", "progress", "spectrum_visualizer", "button", "image"] },
          "parent": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "background": { "type": "string" },
          "radius": { "type": "string" },
          "value": { "type": "string" },
          "color": { "type": "string" },
          "font_size_dip": { "type": "number" },
          "value_source": { "type": "string" },
          "fill": { "type": "string" }
        }
      }
    }
  }
}
