<Window
    x:Class="AetherShell::Settings::MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AetherShell Settings">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        Header="Settings"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="general" Icon="Setting" IsSelected="True"/>
                <NavigationViewItem Content="Taskbar &amp; States" Tag="taskbar" Icon="DockBottom"/>
                <NavigationViewItem Content="Desktop Layering" Tag="desktop" Icon="Pictures"/>
                <NavigationViewItem Content="Widgets &amp; Themes" Tag="widgets" Icon="Shop"/>
                <NavigationViewItem Content="Audio Visualization" Tag="audio" Icon="Volume"/>
                <NavigationViewItem Content="Script Trust &amp; Security" Tag="scripts" Icon="Permissions"/>
            </NavigationView.MenuItems>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Frame x:Name="ContentFrame" Margin="24"/>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
